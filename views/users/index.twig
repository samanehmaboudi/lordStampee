{{ include('layouts/header.twig', { title: 'Utilisateurs' }) }}

{% set assets_base = (asset is defined and asset) ? asset : (base ~ '/public') %}
<link rel="stylesheet" href="{{ assets_base }}/assets/css/variable.css?v=2">
<link rel="stylesheet" href="{{ assets_base }}/assets/css/auth.css?v=4">
{# si tu as mis le bloc dans un fichier séparé: #}
{# <link rel="stylesheet" href="{{ assets_base }}/assets/css/users.css?v=1"> #}

<section class="auth-wrap">
  <div class="auth-card">
    <div class="header-row">
      <h1 class="auth-title">Utilisateurs</h1>
    </div>

    {% if session.flash_ok %}
      <div class="alert alert-success">{{ session.flash_ok }}</div>
    {% endif %}

    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Nom</th>
            <th>Email</th>
            <th>Créé</th>
          </tr>
        </thead>
        <tbody>
          {% for u in users %}
            <tr>
              <td data-label="ID">{{ u.id }}</td>
              <td data-label="Nom">{{ u.name|e }}</td>
              <td data-label="Email">{{ u.email|e }}</td>
              <td data-label="Créé">{{ u.creationDate }}</td>
            </tr>
          {% else %}
            <tr><td colspan="4" style="text-align:center;color:var(--muted);padding:14px 10px">Aucun utilisateur.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="actions">
      <a class="button" style="width:auto" href="{{ base }}/users/create">Créer un utilisateur</a>
    </div>
  </div>
</section>

{{ include('layouts/footer.twig') }}
