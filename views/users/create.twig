{{ include('layouts/header.twig', { title: 'Créer un utilisateur' }) }}

{% set assets_base = (asset is defined and asset) ? asset : (base ~ '/public') %}
<link rel="stylesheet" href="{{ assets_base }}/assets/css/variable.css?v=2">
<link rel="stylesheet" href="{{ assets_base }}/assets/css/auth.css?v=4">

<section class="center-page">
  <div class="auth-wrap">
    <div class="auth-card">
      <h1 class="auth-title">Créer un utilisateur</h1>

      <form action="{{ base }}/users/create" method="post">
        <div class="form-field">
          <label class="form-label" for="name">Nom</label>
          <input class="form-input {{ name_err ? 'is-error' : '' }}" id="name" name="name" value="{{ name|e }}" required>
          {% if name_err %}<div class="form-error">{{ name_err }}</div>{% endif %}
        </div>

        <div class="form-field">
          <label class="form-label" for="email">Email</label>
          <input class="form-input {{ email_err ? 'is-error' : '' }}" id="email" name="email" type="email" value="{{ email|e }}" required>
          {% if email_err %}<div class="form-error">{{ email_err }}</div>{% endif %}
        </div>

        <div class="form-field">
          <label class="form-label" for="password">Mot de passe</label>
          <input class="form-input {{ password_err ? 'is-error' : '' }}" id="password" name="password" type="password" required>
          {% if password_err %}<div class="form-error">{{ password_err }}</div>{% endif %}
        </div>

        {% if exists_err %}<div class="alert alert-error">{{ exists_err }}</div>{% endif %}

        <div class="form-actions">
          <button class="button" type="submit">Créer</button>
          <a class="button button-ghost" href="{{ base }}/users">Retour à la liste</a>
        </div>
      </form>
    </div>
  </div>
</section>

{{ include('layouts/footer.twig') }}
