{{ include('layouts/header.twig', { title: 'Mon profil' }) }}

{% set assets_base = (asset is defined and asset) ? asset : (base ~ '/public') %}
<link rel="stylesheet" href="{{ assets_base }}/assets/css/variable.css?v=2">
<link rel="stylesheet" href="{{ assets_base }}/assets/css/auth.css?v=4">
{# si tu as mis le bloc dans un fichier séparé: #}
{# <link rel="stylesheet" href="{{ assets_base }}/assets/css/users.css?v=1"> #}

<section class="auth-wrap">
  <div class="auth-card">
    <h1 class="auth-title">Mon profil</h1>
    <p class="auth-desc">Mettez à jour vos informations et votre mot de passe.</p>

    {% if session.flash_ok %}<div class="alert alert-success">{{ session.flash_ok }}</div>{% endif %}
    {% if session.flash_err %}<div class="alert alert-error">{{ session.flash_err }}</div>{% endif %}

    <form method="post" action="{{ base }}/profil">
      <input type="hidden" name="csrf" value="{{ csrf }}">
      <div class="form-field">
        <label class="form-label" for="name">Nom</label>
        <input class="form-input" id="name" name="name" value="{{ user.name|e }}" required>
      </div>
      <div class="form-field">
        <label class="form-label" for="email">Email</label>
        <input class="form-input" id="email" name="email" type="email" value="{{ user.email|e }}" required>
      </div>
      <div class="form-actions">
        <button class="button" type="submit">Enregistrer</button>
      </div>
    </form>

    <hr style="margin:24px 0;border:none;border-top:1px solid var(--border)">

    <h2 class="auth-title" style="font-size:20px;margin-bottom:10px">Changer le mot de passe</h2>
    <form method="post" action="{{ base }}/profil/mot-de-passe">
      <input type="hidden" name="csrf" value="{{ csrf }}">
      <div class="form-field">
        <label class="form-label" for="current_password">Actuel</label>
        <input class="form-input" type="password" id="current_password" name="current_password" required>
      </div>
      <div class="form-field">
        <label class="form-label" for="new_password">Nouveau</label>
        <input class="form-input" type="password" id="new_password" name="new_password" required>
      </div>
      <div class="form-field">
        <label class="form-label" for="confirm_password">Confirmer</label>
        <input class="form-input" type="password" id="confirm_password" name="confirm_password" required>
      </div>
      <div class="form-actions">
        <button class="button" type="submit">Mettre à jour</button>
      </div>
    </form>
  </div>
</section>

{{ include('layouts/footer.twig') }}
