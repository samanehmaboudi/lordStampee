<style>
:root{
  --bg:#0f172a; --surface:#fff; --muted:#64748b; --border:#e2e8f0;
  --ring:#c7d2fe; --primary:#4f46e5; --primary-600:#4338ca; --danger:#ef4444;
  --shadow:0 10px 25px rgba(2,6,23,.05);
}
.stamp-edit{max-width:1100px;margin:32px auto 56px;padding:20px 16px}
.page-title{font-size:clamp(22px,3vw,28px);font-weight:700;margin:4px 0 20px;color:#0f172a}
.form{display:grid;grid-template-columns:1fr;gap:18px}
@media(min-width:900px){.form{grid-template-columns:1fr 1fr;gap:22px}}
.form-group,.fieldset{background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:14px 14px 16px;box-shadow:var(--shadow)}
.form-group label{display:block;font-weight:600;margin:2px 0 8px;color:#0f172a}
.form-group input[type="text"],.form-group input[type="date"],.form-group input[type="number"],.form-group select,.form-group input:not([type]){width:100%;height:40px;border:1px solid var(--border);border-radius:10px;padding:8px 10px;font-size:14px;background:#fff;transition:border-color .18s,box-shadow .18s}
.form-group input:focus,.form-group select:focus{outline:none;border-color:var(--primary);box-shadow:0 0 0 4px var(--ring)}
.fieldset{grid-column:1/-1}
.fieldset>legend{font-weight:700;padding:0 4px;color:#0f172a}
.note{color:var(--muted);font-size:13px;margin-top:6px}
.image-previews{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:14px;margin-top:10px}
.img-option{position:relative;border:1px solid var(--border);border-radius:12px;background:#fff;padding:10px;box-shadow:var(--shadow);transition:transform .12s,box-shadow .12s,border-color .12s}
.img-option:hover{transform:translateY(-1px);border-color:#cbd5e1;box-shadow:0 12px 28px rgba(2,6,23,.07)}
.img-option img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:8px;display:block;background:#f8fafc}
.filename{margin-top:8px;font-size:12px;color:var(--muted);line-height:1.3}
.img-option.is-primary{border-color:var(--primary);box-shadow:0 0 0 4px rgba(79,70,229,.15)}
.radio-badge{position:absolute;top:8px;left:8px;z-index:1;font-size:12px;color:#0f172a;background:#fff;border:1px solid var(--border);border-radius:999px;padding:2px 8px;box-shadow:var(--shadow)}
.fieldset label[style*="display:block"]{font-weight:600;color:#0f172a}
.fieldset input[type="radio"]{transform:translateY(.1rem)}
input[type="file"]{width:100%;border:1px dashed #cbd5e1;background:#f8fafc;padding:12px;border-radius:12px}
.form-actions{grid-column:1/-1;display:flex;gap:10px;align-items:center;justify-content:flex-start;margin-top:4px}
.btn{appearance:none;border:none;cursor:pointer;border-radius:12px;padding:10px 16px;font-weight:600;font-size:14px}
.btn-primary{background:var(--primary);color:#fff;box-shadow:0 8px 18px rgba(79,70,229,.25);transition:background .12s,transform .06s}
.btn-primary:hover{background:var(--primary-600)} .btn-primary:active{transform:translateY(1px)}
.btn-link{color:var(--muted);background:transparent;padding-left:0;text-decoration:underline}
.alert{grid-column:1/-1;padding:12px 14px;border-radius:12px;font-weight:600}
.alert-error{background:#fee2e2;color:#991b1b;border:1px solid #fecaca}
.alert-success{background:#dcfce7;color:#14532d;border:1px solid #bbf7d0}
.hidden{display:none}
</style>

