







{# Chemin assets pour construire l'URL du CSS de page #}
{% set _assets = (asset is defined and asset) ? asset : (base ~ '/public') %}

{# Header + chargement du CSS spécifique à cette page #}
{% include 'layouts/header.twig' with {
  'title': 'Créer un timbre',
  'page_css': [_assets ~ '/assets/css/stamps.css?v=1']
} %}

<script defer src="{{ _assets }}/assets/js/main-photo.js?v=1"></script>


<main class="container stamp-create">
  <h1 class="page-title">Ajouter un timbre</h1>

  {% if error %}
    <p class="alert alert-error">{{ error|e }}</p>
  {% endif %}
  {% if success %}
    <p class="alert alert-success">{{ success|e }}</p>
  {% endif %}

  <form class="form" action="{{ base }}/stamps/create" method="post" enctype="multipart/form-data">
    <div class="form-group">
      <label for="name">Nom du timbre *</label>
      <input id="name" name="name" required maxlength="45">
    </div>

    <div class="form-group">
      <label for="creationYear">Année de création *</label>
      <input id="creationYear" type="number" name="creationYear"
         min="1800" max="2025" step="1" required>
    </div>

    <div class="form-group">
      <label for="country_id">Pays *</label>
      <select id="country_id" name="country_id" required>
        
        {% for c in countries %}
          <option value="{{ c.id }}">{{ c.name|e }}</option>
        {% endfor %}
      </select>
    </div>

    <div class="form-group">
      <label for="category_id">Catégorie *</label>
      <select id="category_id" name="category_id" required>
        {% for c in categories %}
          <option value="{{ c.id }}">{{ c.name|e }}</option>
        {% endfor %}
      </select>
    </div>

    <div class="form-group">
      <label for="condition_id">Condition *</label>
      <select id="condition_id" name="condition_id" required>
        {% for c in conditions %}
          <option value="{{ c.id }}">{{ c.name|e }}</option>
        {% endfor %}
      </select>
    </div>

    <div class="form-group">
      <label for="color_id">Couleur (optionnel)</label>
      <select id="color_id" name="color_id">
        <option value="">—</option>
        {% for c in colors %}
          <option value="{{ c.id }}">{{ c.name|e }}</option>
        {% endfor %}
      </select>
    </div>

      <fieldset class="fieldset">
  <legend>Images *</legend>

  <div class="form-group">
    <input id="images" type="file" name="images[]" accept="image/jpeg,image/png,image/webp" multiple required>

    <p class="note">Formats acceptés : JPG/PNG/WebP. Vous pouvez sélectionner plusieurs fichiers.</p>
  </div>

  <div class="form-group">
    <label>Choisir l’image principale *</label>
    <div id="image-previews" class="image-previews">
      <p class="note">Sélectionnez des fichiers ci-dessus : un aperçu avec un bouton radio apparaîtra pour choisir l’image principale.</p>
    </div>
  </div>

  {# Fallback sans JavaScript : on garde le champ numérique #}
  <noscript>
    <div class="form-group">
      <label for="primary_index">Index de l'image principale</label>
      <input id="primary_index" type="number" name="primary_index" min="0" value="0" required>
    </div>
  </noscript>
</fieldset>


   

    <div class="form-actions">
      <button class="btn btn-primary" type="submit">Enregistrer</button>
      <a class="btn btn-link" href="{{ base }}/stamps">Annuler</a>
    </div>
  </form>
</main>

{% include 'layouts/footer.twig' %}


<style>
/* =============================
   Lord Stampee – Create Stamp
   Clean, modern, responsive UI
   ============================= */

:root{
  --bg:#0f172a;
  --surface:#ffffff;
  --muted:#64748b;
  --border:#e2e8f0;
  --ring:#c7d2fe;
  --primary:#4f46e5;
  --primary-600:#4338ca;
  --danger:#ef4444;
  --shadow:0 10px 25px rgba(2,6,23,.05);
}

.stamp-create{
  max-width: 1100px;
  margin: 32px auto 56px;
  padding: 20px 16px;
}

.page-title{
  font-size: clamp(22px, 3vw, 28px);
  font-weight: 700;
  margin: 4px 0 20px;
  letter-spacing:.3px;
  color:#0f172a;
}

.form{
  display:grid;
  grid-template-columns: 1fr;
  gap: 18px;
}
@media (min-width: 900px){
  .form{
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }
}

.form-group,
.fieldset{
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 14px 14px 16px;
  box-shadow: var(--shadow);
}

.form-group label{
  display:block;
  font-weight:600;
  margin: 2px 0 8px;
  color:#0f172a;
}

.form-group input[type="text"],
.form-group input[type="date"],
.form-group input[type="number"],
.form-group select,
.form-group input:not([type]){
  width: 100%;
  height: 40px;
  border:1px solid var(--border);
  border-radius: 10px;
  padding: 8px 10px;
  font-size: 14px;
  background:#fff;
  transition: border-color .18s ease, box-shadow .18s ease;
}
.form-group input:focus,
.form-group select:focus{
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 4px var(--ring);
}

/* fieldsets full width */
.fieldset{
  grid-column: 1 / -1;
}
.fieldset > legend{
  font-weight:700;
  padding: 0 4px;
  color:#0f172a;
}

/* Help text */
.note{
  color: var(--muted);
  font-size: 13px;
  margin-top: 6px;
}

/* File input */
input[type="file"]{
  width:100%;
  border:1px dashed #cbd5e1;
  background:#f8fafc;
  padding:12px;
  border-radius:12px;
}

/* Image previews */
.image-previews{
  display:grid;
  grid-template-columns: repeat(auto-fill, minmax(160px,1fr));
  gap: 14px;
  margin-top:8px;
}
.img-option{
  position:relative;
  border:1px solid var(--border);
  border-radius:12px;
  background:#fff;
  padding:10px;
  box-shadow: var(--shadow);
  transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease;
}
.img-option:hover{
  transform: translateY(-1px);
  border-color:#cbd5e1;
  box-shadow: 0 12px 28px rgba(2,6,23,.07);
}
.img-option img{
  width:100%;
  aspect-ratio: 4/3;
  object-fit:cover;
  border-radius:8px;
  display:block;
  background:#f8fafc;
}
.filename{ margin-top:8px; font-size:12px; color:var(--muted); line-height:1.3; }

/* Badge 'Principale' for the chosen radio */
.img-option.is-primary{
  border-color: var(--primary);
  box-shadow: 0 0 0 4px rgba(79,70,229,.15);
}
.radio-badge{
  position:absolute; top:8px; left:8px; z-index:1;
  font-size:12px; color:#0f172a;
  background:#fff; border:1px solid var(--border);
  border-radius:999px; padding:2px 8px; box-shadow:var(--shadow);
}

/* Actions */
.form-actions{
  grid-column: 1 / -1;
  display:flex;
  gap:10px;
  align-items:center;
  justify-content:flex-start;
  margin-top: 4px;
}
.btn{
  appearance:none; border:none; cursor:pointer;
  border-radius:12px; padding:10px 16px; font-weight:600; font-size:14px;
}
.btn-primary{
  background: var(--primary); color:#fff;
  box-shadow:0 8px 18px rgba(79,70,229,.25);
  transition: background .12s ease, transform .06s ease;
}
.btn-primary:hover{ background: var(--primary-600); }
.btn-primary:active{ transform: translateY(1px); }
.btn-link{ color: var(--muted); background: transparent; padding-left:0; text-decoration: underline; }

/* Alerts */
.alert{ grid-column:1 / -1; padding:12px 14px; border-radius:12px; font-weight:600; }
.alert-error{ background:#fee2e2; color:#991b1b; border:1px solid #fecaca; }
.alert-success{ background:#dcfce7; color:#14532d; border:1px solid #bbf7d0; }

/* Utility */
.hidden{ display:none; }
</style>

