{{ include('layouts/header-auth.twig', { title: "S'inscrire" }) }}

<div class="auth-wrap">
  <main class="auth-card" role="main">
    <h1 class="auth-title">Créer un compte</h1>
    <p class="auth-desc">Rejoignez la communauté Lord Stampee.</p>

    {% if exists_err %}<div class="alert alert-error">{{ exists_err }}</div>{% endif %}

    <form method="post" action="{{ base }}/register" novalidate>
      <div class="form-field">
        <label class="form-label" for="name">Nom</label>
        <input class="form-input {{ name_err ? 'is-error' : '' }}"
               type="text" id="name" name="name" value="{{ name|e }}" required>
        {% if name_err %}<div class="form-error">{{ name_err }}</div>{% endif %}
      </div>

      <div class="form-field">
        <label class="form-label" for="email">Email</label>
        <input class="form-input {{ email_err ? 'is-error' : '' }}"
               type="email" id="email" name="email" value="{{ email|e }}" required>
        {% if email_err %}<div class="form-error">{{ email_err }}</div>{% endif %}
      </div>

      <div class="form-field">
        <label class="form-label" for="password">Mot de passe</label>
        <input class="form-input {{ password_err ? 'is-error' : '' }}"
               type="password" id="password" name="password" required autocomplete="new-password">
        {% if password_err %}<div class="form-error">{{ password_err }}</div>{% endif %}
      </div>

      <div class="form-field">
        <label class="form-label" for="confirm_password">Confirmer le mot de passe</label>
        <input class="form-input {{ confirm_password_err ? 'is-error' : '' }}"
               type="password" id="confirm_password" name="confirm_password" required autocomplete="new-password">
        {% if confirm_password_err %}<div class="form-error">{{ confirm_password_err }}</div>{% endif %}
      </div>

      <div class="form-actions">
        <button class="button" type="submit">Créer le compte</button>
        <a class="button button-ghost" href="{{ base }}/login">J’ai déjà un compte</a>
      </div>
    </form>

    <div class="footnote">Vos données restent confidentielles.</div>
  </main>
</div>

{{ include('layouts/footer-auth.twig') }}
