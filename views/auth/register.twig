{{ include('layouts/header-auth.twig', { title: "S'inscrire" }) }}
<div class="container">
  <h2>Créer un compte</h2>
  {% if exists_err %}<div class="error">{{ exists_err }}</div>{% endif %}

  <form action="{{ base }}/register" method="post" novalidate>
    <div class="form-group">
      <label>Nom</label>
      <input type="text" name="name" value="{{ name|e }}" required>
      {% if name_err %}<div class="error">{{ name_err }}</div>{% endif %}
    </div>

    <div class="form-group">
      <label>Email</label>
      <input type="email" name="email" value="{{ email|e }}" required>
      {% if email_err %}<div class="error">{{ email_err }}</div>{% endif %}
    </div>

    <div class="form-group">
      <label>Mot de passe</label>
      <input type="password" name="password" required>
      {% if password_err %}<div class="error">{{ password_err }}</div>{% endif %}
    </div>

    <div class="form-group">
      <label>Confirmer le mot de passe</label>
      <input type="password" name="confirm_password" required>
      {% if confirm_password_err %}<div class="error">{{ confirm_password_err }}</div>{% endif %}
    </div>

    <button type="submit" class="btn">Créer le compte</button>
    <p>Déjà inscrit ? <a href="{{ base }}/login">Se connecter</a>.</p>
  </form>
</div>

{{ include('layouts/footer-auth.twig') }}
