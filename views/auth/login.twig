{{ include('layouts/header-auth.twig', { title: 'Connexion' }) }}

<div class="container">
  <h2>Connexion</h2>
  {% if flash %}<div class="alert alert-success">{{ flash }}</div>{% endif %}
  {% if logout_success %}<div class="success-message">{{ logout_success }}</div>{% endif %}
  {% if login_err %}<div class="error-message">{{ login_err }}</div>{% endif %}

  <form action="{{ base }}/login" method="post" novalidate>
    <div class="form-group">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="{{ email|e }}" required autofocus autocomplete="email"
             class="{{ email_err ? 'input-error' : '' }}">
      {% if email_err %}<div class="error-message">{{ email_err }}</div>{% endif %}
    </div>

    <div class="form-group">
      <label for="password">Mot de passe</label>
      <input type="password" id="password" name="password" required autocomplete="current-password"
             class="{{ password_err ? 'input-error' : '' }}">
      {% if password_err %}<div class="error-message">{{ password_err }}</div>{% endif %}
    </div>

    <button type="submit" class="btn">Connexion</button>
    <p>Pas encore de compte ? <a href="{{ base }}/register">Inscrivez-vous</a>.</p>
  </form>
</div>

{{ include('layouts/footer-auth.twig') }}
