{# chemins sûrs #}
{% set base_default = '/Stampee-new/Projet-web1-sprint1' %}
{% set base        = base  | default(base_default) %}
{% set asset       = asset | default(base ~ '/public') %}
{% set assets_base = assets_base | default(asset) %}

{# valeurs par défaut pour l'UI si le contrôleur n'envoie pas #}
{% set filters = filters | default({
  year_min: 1750,
  year_max: 2024,
  country_id: '',
  price_min: 0,
  price_max: 7500,
  sort: 'newest',
  condition_id: []   # multi-conditions cochées
}) %}
{% set countries  = countries  | default([]) %}
{% set conditions = conditions | default([]) %}

{% include 'layouts/header.twig' with {
  title: 'Catalogue',
  page_css: [
    assets_base ~ '/assets/css/grid.css?v=1',
    assets_base ~ '/assets/css/filtre.css?v=1',
    assets_base ~ '/assets/css/barre-recherche.css?v=1',
    assets_base ~ '/assets/css/banner-devenir-membre.css?v=1',
    assets_base ~ '/assets/css/timbres-pagination.css?v=1',
    assets_base ~ '/assets/css/carte.css?v=1'
  ]
} %}

<main>
  <div class="aaa">

    {# ===================== Filtres ===================== #}
    <form class="filtre-container" id="filters" method="get" action="{{ base }}/catalogue">
      <h3>Filtrer les timbres</h3>

      <!-- Année d'émission -->
      <div class="filtre-group">
        <label>Année d’émission</label>
        <div class="filtre-range">
          <input type="range" name="year_min" id="year_min" min="1700" max="2024"
                 value="{{ filters.year_min }}" data-autosubmit>
          <input type="range" name="year_max" id="year_max" min="1700" max="2024"
                 value="{{ filters.year_max }}" data-autosubmit>
          <span id="lblYears" class="valfix">{{ filters.year_min }} - {{ filters.year_max }}</span>
        </div>
      </div>

      <!-- Pays d'origine -->
      <div class="filtre-group">
        <label for="country_id">Pays d'origine</label>
        <select id="country_id" name="country_id" data-autosubmit>
          <option value="">Tous</option>
          {% for c in countries %}
            <option value="{{ c.id }}" {{ c.id == filters.country_id ? 'selected' : '' }}>{{ c.name }}</option>
          {% endfor %}
        </select>
      </div>

      <!-- Prix -->
      <div class="filtre-group">
        <label>Filtrer par prix</label>
        <div class="filtre-range">
          <input type="range" name="price_min" id="price_min" min="0" max="10000" step="0.5"
                 value="{{ filters.price_min }}" data-autosubmit>
          <input type="range" name="price_max" id="price_max" min="0" max="10000" step="0.5"
                 value="{{ filters.price_max }}" data-autosubmit>
          <span id="lblPrices" class="valfix">{{ filters.price_min }}$ - {{ filters.price_max }}$</span>
        </div>
      </div>

      <!-- Condition (multi) -->
      <fieldset class="filtre-section">
        <legend>Condition (État du timbre)</legend>
        {% for cond in conditions %}
          <label class="checkline">
            <input type="checkbox" name="condition_id[]" value="{{ cond.id }}"
                   {{ cond.id in filters.condition_id ? 'checked' : '' }} data-autosubmit>
            {{ cond.name }}
          </label>
        {% endfor %}
      </fieldset>

      <!-- Tri -->
      <div class="filtre-group">
        <label for="sort">Trier par</label>
        <select id="sort" name="sort" data-autosubmit>
          <option value="newest"     {{ filters.sort == 'newest'     ? 'selected' : '' }}>Nouveautés</option>
          <option value="price_asc"  {{ filters.sort == 'price_asc'  ? 'selected' : '' }}>Prix ↑</option>
          <option value="price_desc" {{ filters.sort == 'price_desc' ? 'selected' : '' }}>Prix ↓</option>
          <option value="popular"    {{ filters.sort == 'popular'    ? 'selected' : '' }}>Popularité</option>
        </select>
      </div>

      <div class="filtre-actions" style="display:flex; gap:.5rem;">
        <button type="submit" class="btn-appliquer">Appliquer</button>
        <a href="{{ base }}/catalogue" class="btn-reset">Réinitialiser</a>
      </div>
    </form>

    {# ===================== Contenu ===================== #}
    <div class="timbres-container">
      <!-- Barre de recherche (statique) -->
      <div class="timbres-search-bar">
        <div class="search-box">
          <label for="recherche-scott" class="visually-hidden">Rechercher par numéro Scott :</label>
          <input type="text" id="recherche-scott" placeholder="#Scott">
          <button class="search-btn">
            <i class="fas fa-search"></i>
            <span class="visually-hidden">Rechercher avec le numéro Scott</span>
          </button>
        </div>
        <div class="search-box">
          <label for="recherche-annee" class="visually-hidden">Rechercher par année :</label>
          <input type="text" id="recherche-annee" placeholder="#Année">
          <button class="search-btn">
            <i class="fas fa-search"></i>
            <span class="visually-hidden">Rechercher avec l'année</span>
          </button>
        </div>
      </div>

      <div class="banner-devenir-membre">
        <button class="btn-devenir-membre">Devenir Membre</button>
        {% if loggedin|default(false) %}
          <a href="{{ base }}/stamps/create" class="btn-devenir-membre">+ Ajouter un timbre</a>
        {% endif %}
      </div>

      <!-- Pagination (statique pour l’instant) -->
      <div class="timbres-pagination">
        <button class="pagination-arrow">
          <i class="fas fa-chevron-left"></i>
          <span class="visually-hidden">Page précédente</span>
        </button>
        <span class="page-number">1</span>
        <span class="page-number">2</span>
        <span class="page-number">3</span>
        <span class="dots">...</span>
        <span class="page-number">10</span>
        <button class="pagination-arrow">
          <i class="fas fa-chevron-right"></i>
          <span class="visually-hidden">Page suivante</span>
        </button>
      </div>

      <section class="catalogue-container">
        <h2>Collection de Timbres</h2>

        <div class="catalogue-grid">
          {% for s in stamps %}
            <article class="carte">
              <a href="{{ base }}/fiche-produit?id={{ s.id }}" class="lien-produit">Voir plus de détails</a>

              <figure class="carte-image">
                {% set raw = s.main_image|default('') %}
                {% if raw %}
                  {% set clean = raw|trim('/') %}
                  {% set img_src = asset ~ '/' ~ clean %}
                {% else %}
                  {% set img_src = asset ~ '/assets/images/img-catalogue/photo-GB-1840.jpg' %}
                {% endif %}
                <img src="{{ img_src }}" alt="{{ s.name|e }}"
                     onerror="this.onerror=null;this.src='{{ asset }}/assets/images/img-catalogue/photo-GB-1840.jpg'">
              </figure>

              <div class="carte-details">
                <h3 class="carte-titre">{{ s.name|e }}</h3>
                {% if s.current_price is not null %}
                  <p class="carte-prix">${{ s.current_price|number_format(2, '.', ' ') }}</p>
                {% endif %}
              </div>

              <nav class="carte-actions">
                <button aria-label="Ajouter aux favoris">
                  <i class="fa-regular fa-heart"></i>
                </button>
                <a href="{{ base }}/fiche-produit?id={{ s.id }}" aria-label="Voir plus de détails">
                  <i class="fa-solid fa-arrow-right"></i>
                </a>
              </nav>
            </article>
          {% else %}
            <p style="grid-column:1 / -1;">Aucun timbre pour l’instant.</p>
          {% endfor %}
        </div>
      </section>
    </div>
  </div>
</main>

{% include 'layouts/footer.twig' %}

{# petite aide visuelle pour que les labels ne fassent pas bouger le panneau #}
<style>
  .valfix{display:inline-block;min-width:12ch;text-align:right}
  .filtre-range{display:flex;align-items:center;gap:.5rem}
  .checkline{display:flex;gap:.5rem;align-items:center;margin:.25rem 0}
</style>

{# JS externe pour l’auto-apply/AJAX des filtres #}
<script src="{{ assets_base }}/assets/js/filtre-avance.js?v=1"></script>
