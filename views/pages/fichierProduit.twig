{# chemins sûrs #} 
{% set base_default = '/Stampee-new/Projet-web1-sprint1' %}
{% set base        = base  | default(base_default) %}
{% set asset       = asset | default(base ~ '/public') %}
{% set assets_base = assets_base | default(asset) %}

{# === HEAD (via header.twig) === #}
{% include 'layouts/header.twig' with {
  title: stamp.name is defined ? stamp.name : 'Fiche produit',
  page_css: [
    assets_base ~ '/assets/css/grid.css?v=1',
    assets_base ~ '/assets/css/galerie-image.css?v=1',
    assets_base ~ '/assets/css/details-produit.css?v=1',
    assets_base ~ '/assets/css/description.css?v=1',
    assets_base ~ '/assets/css/mise.css?v=1',
    assets_base ~ '/assets/css/historique-offres.css?v=1',
    assets_base ~ '/assets/css/carte.css?v=1'
  ],
  page_js: [
    assets_base ~ '/assets/js/gallery-thumbs.js?v=1',
    assets_base ~ '/assets/js/zoom-image.js?v=1'
  ]
} %}

{# === Prépare l’image principale (uploads) === #}
{% set main = null %}
{% if images is defined and images|length > 0 %}
  {% for img in images %}
    {% if img.image_type == 'Main' and main is null %}
      {% set main = img %}
    {% endif %}
  {% endfor %}
  {% if main is null %}{% set main = images[0] %}{% endif %}
  {% set clean = main.image_url|default('')|trim('/') %}
  {% set main_src = clean ? (asset ~ '/' ~ clean) : (assets_base ~ '/assets/images/placeholder.png') %}
{% else %}
  {% set main_src = assets_base ~ '/assets/images/placeholder.png' %}
{% endif %}

<main>
  <div class="contenu-principal">

    <header class="titre-produit">
      <h1>{{ stamp.name|default('Timbre') }}</h1>
    </header>

    {# Flash #}
    {% if error %}<p class="alert alert-error">{{ error }}</p>{% endif %}
    {% if success %}<p class="alert alert-success">{{ success }}</p>{% endif %}

    <div class="container">

      <!-- Colonne gauche : galerie + description + mise -->
      <aside class="image-container">
        <div class="galerie-images">

          {# =================== FAV =================== #}
          {% set isFav = stamp.is_favorite|default(false) %}
          {% if loggedin|default(false) %}
            <form class="fav-form" action="{{ base }}/favoris/toggle" method="post">
              <input type="hidden" name="stamp_id" value="{{ stamp.id }}">
              <button
                type="submit"
                class="btn-fav icone-coeur {{ isFav ? 'is-on' : '' }}"
                aria-pressed="{{ isFav ? 'true' : 'false' }}"
                title="{{ isFav ? 'Retirer des favoris' : 'Ajouter aux favoris' }}"
              >
                <i class="{{ isFav ? 'fa-solid' : 'fa-regular' }} fa-heart" aria-hidden="true"></i>
                <span class="visually-hidden">
                  {{ isFav ? 'Retirer des favoris' : 'Ajouter aux favoris' }}
                </span>
              </button>
            </form>
          {% else %}
            <a class="icone-coeur" href="{{ base }}/login"
               title="Connectez-vous pour ajouter ce timbre à vos favoris">
              <i class="fa-regular fa-heart" aria-hidden="true"></i>
              <span class="visually-hidden">Favori</span>
            </a>
          {% endif %}
          {# ============== /FAV ======================= #}

          {# Miniatures #}
          {% if images is defined and images|length > 0 %}
            <div class="miniatures">
              {% for img in images %}
                {% set src_clean = img.image_url|default('')|trim('/') %}
                {% set src = src_clean ? (asset ~ '/' ~ src_clean) : (assets_base ~ '/assets/images/placeholder.png') %}
                <img src="{{ src }}" data-full="{{ src }}" alt="Miniature {{ loop.index }}">
              {% endfor %}
            </div>
          {% else %}
            <div class="miniatures">
              <img src="{{ assets_base }}/assets/images/photo-GB-1840.jpg" alt="Miniature 1">
              <img src="{{ assets_base }}/assets/images/photo-GB-1873.jpg" alt="Miniature 2">
              <img src="{{ assets_base }}/assets/images/photo-GB-1875.jpg" alt="Miniature 3">
              <img src="{{ assets_base }}/assets/images/photo-GB-1880.jpg" alt="Miniature 4">
              <img src="{{ assets_base }}/assets/images/photo-GB-1852.jpg" alt="Miniature 5">
            </div>
          {% endif %}

          {# Grande image #}
          <figure class="image-principale">
            <img id="main-photo" src="{{ main_src }}" alt="{{ stamp.name|e }}"
                 onerror="this.onerror=null;this.src='{{ assets_base }}/assets/images/placeholder.png'">
            <figcaption>{{ stamp.name|e }}{% if stamp.creationDate %} — {{ stamp.creationDate|e }}{% endif %}</figcaption>
          </figure>
        </div>

        {# Description #}
        <section class="description">
          <h2>Description</h2>
          <p class="description-encher">
            {{ stamp.description|default("Superbe timbre de collection en excellent état.") }}
          </p>
        </section>

        {# ======= SECTION MISE ======= #}
        {% set cur    = stats.current_price|default(0) %}
        {% set incr   = a.min_increment|default(0.50) %}
        {% set minBid = (cur + incr) %}

        {% if a %}
          {# Enchère existante -> formulaire pour miser #}
          <form class="section-mise" id="bid-form" action="{{ base }}/auctions/bid" method="post" novalidate>
            <input type="hidden" name="auction_id" value="{{ a.id }}">
            <label for="enchere" class="visually-hidden">Entrez votre enchère</label>
            <input
              id="enchere"
              name="amount"
              type="number"
              placeholder="Votre enchère (min {{ minBid|number_format(2, '.', ' ') }} $)"
              min="{{ minBid|number_format(2, '.', '') }}"
              step="{{ incr|number_format(2, '.', '') }}"
              value="{{ minBid|number_format(2, '.', '') }}"
              required
            >
            <button class="btn-miser" type="submit">Placer une enchère</button>
            <p class="hint">Minimum requis : {{ minBid|number_format(2, '.', ' ') }} $</p>
          </form>
        {% else %}
          {# Pas d’enchère -> mini-formulaire de création, visible si connecté #}
          {% if loggedin|default(false) %}
            <form class="section-mise" action="{{ base }}/auctions/create" method="post" novalidate>
              <input type="hidden" name="stamp_id" value="{{ stamp.id }}">
              <h3>Mettre ce timbre aux enchères</h3>
              <div class="ligne" style="display:flex; gap:.75rem; flex-wrap:wrap; align-items:center">
                <label>Prix de départ
                  <input type="number" name="starting_price" step="0.01" min="0" value="10.00" required>
                </label>
                <label>Incrément min.
                  <input type="number" name="min_increment" step="0.01" min="0.01" value="0.50" required>
                </label>
                <label>Durée (jours)
                  <input type="number" name="duration_days" min="1" max="60" value="14" required>
                </label>
                <button type="submit" class="btn-miser">Créer l’enchère</button>
              </div>
              <p class="hint">Après création, le formulaire de mise apparaîtra ici.</p>
            </form>
          {% else %}
            <p>Ce timbre n’est pas encore en enchère. <a href="{{ base }}/login">Connectez-vous</a> pour le mettre aux enchères.</p>
          {% endif %}
        {% endif %}
      </aside>

      <!-- Colonne droite : détails produit -->
      <article class="details-produit">
        <h2>Détails du produit</h2>

        <div class="cote-a-cote">
          <section class="informations">
            <h3>Caractéristiques du produit</h3>
            <p><strong>Pays :</strong> {{ stamp.country_name|default('—') }}</p>
            <p><strong>Catégorie :</strong> {{ stamp.category_name|default('—') }}</p>
            <p><strong>État :</strong> {{ stamp.condition_name|default('—') }}</p>
            <p><strong>Couleur :</strong> {{ stamp.color_name|default('—') }}</p>
            <p><strong>Année d'émission :</strong> {{ stamp.creationDate|default('—') }}</p>

            <button class="badge-miser" type="button" onclick="goBid()">Miser maintenant</button>

            <p class="prix">
              Mise actuelle :
              <strong>{{ cur|number_format(2, '.', ' ') }} $</strong>
            </p>

            <!-- Historique des offres -->
            <details class="historique-offres">
              <summary>Historique des offres ({{ bids|default([])|length }})</summary>
              {% if bids is defined and bids|length > 0 %}
                <ul>
                  {% for b in bids %}
                    <li>
                      <span class="auteur"><strong>{{ b.bidder_name|default('Utilisateur') }}</strong></span>
                      <span class="montant">{{ b.amount|number_format(2, '.', ' ') }} $</span>
                      <span class="date">{{ b.created_at|date('d/m H:i') }}</span>
                    </li>
                  {% endfor %}
                </ul>
              {% else %}
                <p class="vide">Aucune mise pour le moment.</p>
              {% endif %}
            </details>
          </section>

          <!-- Livraison / paiement -->
          <section class="info-livraison">
            <h3>Livraison et paiement</h3>
            <p><strong>Livraison :</strong> Livraison gratuite à partir de 50,00 $</p>
            <p><strong>Prix actuel :</strong> {{ cur|number_format(2, '.', ' ') }} $</p>
            <p><strong>Transaction sécurisée</strong></p>
            <p><strong>Moyens de paiement acceptés :</strong></p>
            <div class="icones-paiement">
              <i class="fab fa-cc-mastercard mastercard" aria-hidden="true"></i>
              <i class="fab fa-cc-visa visa" aria-hidden="true"></i>
              <i class="fab fa-cc-paypal paypal" aria-hidden="true"></i>
            </div>
          </section>
        </div>
      </article>
    </div>

    <!-- Autres produits (statiques pour l’instant) -->
    <div class="container">
      <section class="produits-relies">
        <h2>Autres produits liés</h2>
        <div class="liste-produits">
          <article class="carte-produit">
            <div class="image-produit">
              <img src="{{ assets_base }}/assets/images/photo-GB-1840.jpg" alt="Timbre Bangkok">
            </div>
            <div class="details-produit">
              <h3>BANGKOK 12 USAGÉ</h3>
              <p class="description-produit">Aucun défaut - Très bon état</p>
              <p class="code-stock">Code stock : #155</p>
              <p class="prix">$175.00</p>
              <div class="actions-produit">
                <i class="fa-regular fa-heart"></i>
                <i class="fa-solid fa-arrow-right"></i>
              </div>
            </div>
          </article>

          <article class="carte-produit">
            <div class="image-produit">
              <img src="{{ assets_base }}/assets/images/photo-GB-1873.jpg" alt="Timbre Macao">
              <span class="etiquette promo">En promotion</span>
            </div>
            <div class="details-produit">
              <h3>MACAO 39 USAGÉ</h3>
              <p class="description-produit">Aucun défaut - Très bon état</p>
              <p class="code-stock">Code stock : #187</p>
              <p class="prix"><s>$170.00</s> <strong>$155.00</strong></p>
              <div class="actions-produit">
                <i class="fa-regular fa-heart"></i>
                <i class="fa-solid fa-arrow-right"></i>
              </div>
            </div>
          </article>

          <article class="carte-produit">
            <div class="image-produit">
              <img src="{{ assets_base }}/assets/images/photo-GB-1875.jpg" alt="Timbre Terre-Neuve">
            </div>
            <div class="details-produit">
              <h3>Timbre de Terre-Neuve #8</h3>
              <p class="description-produit rare">Rare - Édition limitée</p>
              <p class="code-stock">Code stock : #111</p>
              <p class="prix">$1.175.00</p>
              <button class="bouton-offre">Faire une offre</button>
              <div class="actions-produit">
                <i class="fa-regular fa-heart"></i>
                <i class="fa-solid fa-arrow-right"></i>
              </div>
            </div>
          </article>

          <article class="carte-produit">
            <div class="image-produit">
              <img src="{{ assets_base }}/assets/images/photo-GB-1880.jpg" alt="Timbre France">
              <span class="etiquette edition">Édition spéciale</span>
            </div>
            <div class="details-produit">
              <h3>Timbre de France 1923</h3>
              <p class="description-produit">Collection unique</p>
              <p class="prix">$195.00</p>
              <div class="actions-produit">
                <i class="fa-regular fa-heart"></i>
                <i class="fa-solid fa-arrow-right"></i>
              </div>
            </div>
          </article>

          <article class="carte-produit">
            <div class="image-produit">
              <img src="{{ assets_base }}/assets/images/photo-GB-1873.jpg" alt="Timbre Italie">
            </div>
            <div class="details-produit">
              <h3>Timbre d'Italie #5</h3>
              <p class="description-produit">État neuf, impeccable</p>
              <p class="code-stock">Code stock : #333</p>
              <p class="prix">$120.00</p>
              <button class="bouton-offre">Faire une offre</button>
              <div class="actions-produit">
                <i class="fa-regular fa-heart"></i>
                <i class="fa-solid fa-arrow-right"></i>
              </div>
            </div>
          </article>
        </div>
      </section>
    </div>

  </div>
</main>

{% include 'layouts/footer.twig' %}

<script>
document.addEventListener('DOMContentLoaded', () => {
  const main = document.querySelector('.image-principale img');
  if (!main) return;
  document.querySelectorAll('.miniatures img').forEach(img => {
    img.addEventListener('click', () => {
      const src = img.dataset.full || img.getAttribute('src');
      if (src) {
        main.src = src;
        document.querySelectorAll('.miniatures img').forEach(i => i.classList.remove('is-active'));
        img.classList.add('is-active');
      }
    });
  });
});
</script>

<script>
function quickBid() {
  const input = document.querySelector('#bid-form input[name="amount"]');
  const form  = document.getElementById('bid-form');
  if (!input || !form) return goBid(); // fallback vers le scroll
  const min = parseFloat(input.getAttribute('min') || '0');
  input.value = (isNaN(min) ? 0 : min).toFixed(2);
  form.submit();
}
function goBid(){
  const el = document.getElementById('bid-form') || document.getElementById('enchere');
  if (el) el.scrollIntoView({behavior:'smooth', block:'center'});
}
function cancelBid(btn){
  // Trouve le bon formulaire (utile s'il y a plusieurs fiches sur la page)
  const form  = btn.closest('form');
  if (!form) return;
  const input = form.querySelector('input[name="amount"]');
  if (input) {
    const min = parseFloat(input.getAttribute('min') || '0');
    input.value = isNaN(min) ? '' : min.toFixed(2);
  }
}
</script>

{# ===== AJAX favoris (progressive enhancement) ===== #}
<script>
document.addEventListener('click', async (e) => {
  const form = e.target.closest('.fav-form');
  if (!form) return;
  e.preventDefault();

  const btn = form.querySelector('.btn-fav');
  const icon = btn.querySelector('i');
  const fd = new FormData(form);

  try {
    const res = await fetch(form.action, {
      method: 'POST',
      headers: {'X-Requested-With':'XMLHttpRequest'},
      body: fd
    });
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const data = await res.json();

    // data.favorite === true -> maintenant en favori
    const on = !!data.favorite;
    btn.classList.toggle('is-on', on);
    btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    icon.classList.toggle('fa-solid', on);
    icon.classList.toggle('fa-regular', !on);
    btn.title = on ? 'Retirer des favoris' : 'Ajouter aux favoris';
  } catch(err) {
    // En cas d’erreur, on retombe sur le POST classique :
    form.submit();
  }
});
</script>

function cancelBid(btn){
  const form  = btn.closest('form');
  if (!form) return;
  const input = form.querySelector('input[name="amount"]');
  if (input) {
    const min = parseFloat(input.getAttribute('min') || '0');
    input.value = isNaN(min) ? '' : min.toFixed(2);
  }
}

